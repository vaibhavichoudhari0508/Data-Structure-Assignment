#include &lt;iostream&gt;
using namespace std;
int main()
{
int queue[5];
int front = 0;
int rear = 0;

cout<<"Enter 5 customer order numbers: \n";
for (int i = 0; i &lt; 5; i++)
{
cin>>queue[rear];
rear++;
}

cout<< "\nProcessing Orders:\n";
while (front &lt; rear)
{
cout<<"Processing Order: "<< queue[front] <<endl;
front++;
}
return 0;
}
